{
  "manifest_version": 3,
  "name": "司法院裁判書閱讀助手",
  "version": "0.3.2",
  "description": "為司法院裁判書加上判決架構目錄、引文參照、六色螢光筆、全文下載與一鍵複製；複製時自動去分行、附字號，並以側邊欄判決剪貼簿跨分頁保存段落。",
  "homepage_url": "https://github.com/han0302-cyber/judicial-outline-extension",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://legal.judicial.gov.tw/FINT/*",
    "https://judgment.judicial.gov.tw/FJUD/*",
    "https://legal.law.intraj/FINT/*",
    "https://judgment.law.intraj/FJUD/*"
  ],
  "action": {
    "default_title": "判決剪貼簿"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://legal.judicial.gov.tw/FINT/*",
        "https://judgment.judicial.gov.tw/FJUD/*",
        "https://legal.law.intraj/FINT/*",
        "https://judgment.law.intraj/FJUD/*"
      ],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
